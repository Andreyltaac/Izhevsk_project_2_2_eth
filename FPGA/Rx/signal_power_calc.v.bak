module signal_power_calc #(
    parameter DATA_WIDTH   = 12,              // Разрядность входа
    parameter OUT_WIDTH    = 32,              // Разрядность выхода (макс 32)
    parameter WINDOW_SIZE  = 1024              // Размер окна N

  
)(
    input  wire                 clk,
    input  wire                 rst_n,
    
  
   (* mark_debug = "true" *) input  wire signed [DATA_WIDTH-1:0] idata_in,
   (* mark_debug = "true" *) input  wire signed [DATA_WIDTH-1:0] qdata_in,
    // Выходное значение мощности 
    output reg  [OUT_WIDTH-1:0] power_out,
    
    // Сигнал валидности (1 такт каждые N тактов)
    output reg                  valid_out
);
	localparam CNT_WIDTH = $clog2(WINDOW_SIZE);
	
    // Внутренние сигналы
    reg [CNT_WIDTH-1:0] sample_cnt;       // Счетчик отсчетов в окне
    reg [OUT_WIDTH-1:0] acc;              // Аккумулятор суммы квадратов
    reg [31:0] sample_sq; // Квадрат текущего отсчета


    
   (* mark_debug = "true" *) wire [23:0] m_abs_data;

    abs_calc
    #(
      .pDAT_W (DATA_WIDTH*2)
    )
    abs_calc_1
    (
      .iclk            (clk),
      .irst            (rst_n),
    	//
      .s_abs_0_data    ({qdata_in,idata_in}),
      .s_abs_0_tvalid  (1),
    	//
      .m_abs_0_data    (m_abs_data)
    );

always @(posedge clk or negedge rst_n) begin
    if (~rst_n)  
	begin
	sample_sq <= 32'b0;
	end
	    else 
		begin 
        sample_sq = m_abs_data[11:0] * m_abs_data[11:0];
		end  
  end

 	
    always @(posedge clk or negedge rst_n) begin
        if (~rst_n) begin
            sample_cnt <= 0;
            acc        <= 0;
            power_out  <= 0;
            valid_out  <= 0;
        end
        else begin
            valid_out <= 0; 

            // Накопление суммы квадратов
               
            acc <= acc + sample_sq[OUT_WIDTH-1:0]; 

            // пнкремент счетчика
            if (sample_cnt == WINDOW_SIZE - 1) begin
                sample_cnt <= 0;
                

                power_out <= acc >>> 10;
                valid_out <= 1;
                
                // Сброс аккумулятора для следующего окна
                acc <= 0;
            end
            else begin
                sample_cnt <= sample_cnt + 1;
            end
        end
    end

endmodule